# Що НЕ відправляти на GitHub.
# Файли з цього списку лишаються на комп'ютері, git їх просто не бачить.

# --- Робочі документи й чернетки (внутрішні нотатки, не для публіки) ---
# Технічне завдання й хендоф у Word: є внутрішні рішення, плани й терміни
*.docx
# Тимчасові файли Word, які з'являються, поки документ відкритий
~$*
# Нотатки для розробки: план, відкриті питання, шлях до папки на цьому комп'ютері
handoff.md

# --- Локальні налаштування Claude Code ---
# Особисті дозволи й налаштування; launch.json і serve.ps1 лишаються в репозиторії
.claude/settings.local.json

# --- Службові файли Windows і macOS ---
# Мініатюри провідника Windows
Thumbs.db
# Налаштування вигляду папки Windows
desktop.ini
# Те саме для macOS
.DS_Store

# --- Редактори коду ---
# Особисті налаштування VS Code
.vscode/
# Особисті налаштування редакторів JetBrains
.idea/

# --- Тимчасове й секрети (на майбутнє) ---
# Тимчасові файли
*.tmp
*.log
# Файли з ключами й паролями, якщо колись з'являться (наприклад, для форми чи аналітики)
.env
.env.*
